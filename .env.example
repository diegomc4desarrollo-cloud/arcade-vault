# Copia este archivo a .env.local y rellena los valores.
# .env.local NO se versiona (está en .gitignore).

# Clave de API de Resend (https://resend.com/api-keys)
RESEND_API_KEY=

# Dirección de destino de los mensajes del formulario de contacto (/acerca-de).
# Con el remitente sandbox onboarding@resend.dev, Resend SOLO entrega al email
# con el que te registraste en Resend: pon ese email aquí.
CONTACT_TO_EMAIL=

# Supabase (https://supabase.com/dashboard/project/_/settings/api).
# Ambas son claves PÚBLICAS (van también al navegador, prefijo NEXT_PUBLIC_).
# NEXT_PUBLIC_SUPABASE_URL: URL del proyecto (https://<ref>.supabase.co).
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY: pega la "publishable key" (sb_publishable_...) del proyecto.
# Sin estas variables el sitio compila igual, pero /api/health/supabase devuelve error.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
